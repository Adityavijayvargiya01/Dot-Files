        },
        {
          "birthYear": 0,
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "lifeExpectancy": 75,
          "verticalFormat": "h\n—\nmm\nAP"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "aditya.grayscale"
        }
      ],
      "left": [
        {
          "id": "aditya.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer"
        },
        {
          "id": "io.github.adityavijayvargiya01.coverglow",
          "layout": "vertical",
          "notifications": false
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [],
          "hidden": []
        },
        {
          "id": "aditya.herdr"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "aditya.menu"
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "aditya.tweet"
    },
    {
      "id": "macos.dock"
    }
  ],
  "version": 1
}
